#include <windows.h>
#include "build_info.h"
#include "resource.h"
#pragma code_page(65001)
1 RT_MANIFEST "app.manifest"
2 RCDATA "../../data/oui.bin"
1 ICON "assets/app.ico"
1 VERSIONINFO
 FILEVERSION APP_VERSION_RESOURCE
 PRODUCTVERSION APP_VERSION_RESOURCE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "FileDescription", "Look@LAN-ng native LAN scanner\0"
   VALUE "ProductName", "Look@LAN-ng\0"
   VALUE "FileVersion", APP_NUMERIC_VERSION "\0"
   VALUE "ProductVersion", APP_VERSION "\0"
   VALUE "LegalCopyright", APP_COPYRIGHT
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
IDD_PROFILE DIALOGEX 0, 0, 370, 280
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Profile"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "", 230, 10, 10, 95, 12
 EDITTEXT IDC_PROFILE_NAME, 110, 8, 250, 14, ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "", 231, 10, 30, 95, 28
 EDITTEXT IDC_PROFILE_RANGES, 110, 28, 250, 54, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
 LTEXT "", 232, 10, 90, 95, 12
 EDITTEXT IDC_PROFILE_PORTS, 110, 88, 250, 14, ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "", 233, 10, 111, 95, 12
 EDITTEXT IDC_PROFILE_ICMP, 110, 109, 60, 14, ES_NUMBER | WS_TABSTOP
 LTEXT "", 234, 195, 111, 105, 12
 EDITTEXT IDC_PROFILE_TCP, 305, 109, 55, 14, ES_NUMBER | WS_TABSTOP
 LTEXT "", 235, 10, 133, 95, 12
 EDITTEXT IDC_PROFILE_CONCURRENCY, 110, 131, 60, 14, ES_NUMBER | WS_TABSTOP
 LTEXT "", 236, 195, 133, 105, 12
 COMBOBOX IDC_PROFILE_INTERVAL, 305, 131, 55, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "", 237, 10, 156, 95, 12
 EDITTEXT IDC_PROFILE_NOTES, 110, 154, 250, 66, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
 LTEXT "", 238, 10, 229, 350, 18
 DEFPUSHBUTTON "OK", IDOK, 250, 256, 50, 16
 PUSHBUTTON "Cancel", IDCANCEL, 310, 256, 50, 16
END
IDD_INPUT DIALOGEX 0, 0, 310, 92
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Look@LAN-ng"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "", IDC_PROMPT, 10, 8, 290, 22
 EDITTEXT IDC_INPUT, 10, 32, 290, 14, ES_AUTOHSCROLL | WS_TABSTOP
 DEFPUSHBUTTON "OK", IDOK, 192, 66, 50, 16
 PUSHBUTTON "Cancel", IDCANCEL, 250, 66, 50, 16
END
